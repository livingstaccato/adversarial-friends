@startuml components
' Module architecture of the afriend package.
' Mirrors the real layout under src/afriend/.

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #37474F
skinparam ArrowFontSize 11
skinparam TitleFontSize 18
skinparam componentStyle rectangle

skinparam rectangle {
  BorderColor #546E7A
  BackgroundColor #ECEFF1
  BorderThickness 1
  FontSize 13
}
skinparam package {
  BorderColor #1565C0
  BackgroundColor #E3F2FD
  FontSize 13
  FontStyle bold
}

title afriend — module architecture

package "Entry" {
  rectangle "cli.py\n<size:11>thin entry + re-exports</size>" as CLI
  rectangle "cliargs.py\n<size:11>parser, friend specs</size>" as ARGS
  rectangle "commands/run.py + environment.py\n<size:11>run orchestration + scope warning</size>" as RUN
  rectangle "commands/doctor.py\n<size:11>readiness diagnostics</size>" as DOC
}

package "Roster & contract" {
  rectangle "commands/friends.py + roster.py\n<size:11>selection, host roles, lenses</size>" as ROSTER
  rectangle "providerconfig.py\n<size:11>persistent enable/model policy</size>" as PCONFIG
  rectangle "readiness.py\n<size:11>effective provider admission</size>" as READY
  rectangle "authority.py\n<size:11>provider-scoped tool grants</size>" as AUTH
  rectangle "adapters.py\n<size:11>argv + capability</size>" as ADAPT
  rectangle "trust.py\n<size:11>allowlist, denied flags</size>" as TRUST
  rectangle "paths.py\n<size:11>bundled asset lookup</size>" as PATHS
}

package "Execute" {
  rectangle "prompt.py\n<size:11>lens prose → prompt</size>" as PROMPT
  rectangle "isolation.py\n<size:11>snapshot, worktrees</size>" as ISO
  rectangle "workspaceassets.py\n<size:11>digest-pinned harness staging</size>" as WSA
  rectangle "sandbox.py + childenv.py\n<size:11>OS policy, resolver binds + env allowlist</size>" as SANDBOX
  rectangle "dispatch.py\n<size:11>argv → process</size>" as DISP
  rectangle "spawn.py\n<size:11>process groups, reaping</size>" as SPAWN
  rectangle "http_transport.py\n<size:11>bounded endpoint process</size>" as HTTPX
}

package "Interpret & record" {
  rectangle "normalize.py\n<size:11>envelope, JSON recovery</size>" as NORM
  rectangle "claimschema.py\n<size:11>payload validation</size>" as SCHEMA
  rectangle "merge.py\n<size:11>exact-merge, aliases</size>" as MERGE
  rectangle "rounds.py + commands/crossexam.py\n<size:11>parallel critique + judging</size>" as ROUNDS
  rectangle "ledger.py\n<size:11>append-only records</size>" as LEDGER
  rectangle "report.py\n<size:11>ranked report.md</size>" as REPORT
  rectangle "runstore.py\n<size:11>run dir layout</size>" as STORE
}

database "assets/\nadapters · harnesses · lenses\nentrypoints/ (five skills)" as ASSETS #FFF8E1
cloud "exec friend CLIs\nclaude · codex · Antigravity (agy) · opencode" as FRIENDS #E8F5E9
cloud "Ollama HTTP endpoint" as HTTP #E8F5E9

CLI --> ARGS
CLI --> RUN
CLI --> DOC

RUN --> ROSTER
RUN --> AUTH
RUN --> PROMPT
RUN --> ISO
RUN --> ROUNDS
RUN --> MERGE
RUN --> STORE
RUN --> REPORT

ARGS --> AUTH
ROSTER --> ADAPT
ROSTER --> PCONFIG
ROSTER --> READY
ROSTER --> TRUST
READY --> PCONFIG
READY --> AUTH
READY --> ADAPT
DOC --> READY

PATHS --> ASSETS
ADAPT ..> PATHS
PROMPT ..> PATHS
WSA ..> PATHS

ROUNDS --> DISP
DISP --> ADAPT
DISP --> AUTH
DISP --> TRUST
DISP --> WSA
DISP --> SANDBOX
DISP --> SPAWN
DISP --> HTTPX
SPAWN --> FRIENDS
SPAWN --> NORM
HTTPX --> HTTP
HTTPX --> NORM
NORM --> SCHEMA

MERGE --> LEDGER
STORE --> LEDGER
REPORT --> LEDGER

@enduml
